## REQUIRED — server will refuse to start without a strong secret (min 32 chars)
JWT_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET_MINIMUM_32_CHARS

PORT=3001
DATABASE_PATH=./blink.db

## CORS — set to your production client URL (default: http://localhost:5173)
# CLIENT_ORIGIN=https://blink.example.com

## Set to 'true' to allow CORS from private/LAN IPs (default: false)
# ALLOW_LAN=true

## Limits (defaults shown — override as needed)
# MAX_DEVICES_PER_USER=5
# MAX_STORAGE_PER_USER=524288000   # 500 MB in bytes
# MAX_CONVERSATIONS_PER_USER=500
