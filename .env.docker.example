# ─────────────────────────────────────────────────────────────────────
# blink-text Docker environment
# Copy this file to .env and edit:   cp .env.docker.example .env
# ─────────────────────────────────────────────────────────────────────

## REQUIRED — the app container will refuse to start without this.
## Must be at least 32 characters. Generate one with:
##   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET_MINIMUM_32_CHARS

## Public origin of your site (used for CORS). No trailing slash.
## Examples: http://localhost, https://blink.example.com
CLIENT_ORIGIN=http://localhost

## Host port that nginx listens on (maps to container port 80)
HTTP_PORT=80

## Set to 'true' to allow CORS from private/LAN IPs (192.168.*, 10.*, etc.)
# ALLOW_LAN=false

## Limits (defaults shown — override as needed)
# MAX_DEVICES_PER_USER=5
# MAX_STORAGE_PER_USER=524288000
# MAX_CONVERSATIONS_PER_USER=500
